{
  "manifest_version": 2,
  "name": "Perchance Image Downloader",
  "version": "2.0.0",
  "description": "Download generated images from Perchance AI Image Generator",
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "activeTab",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "notifications"
  ],
  "web_accessible_resources": [
    "icons/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://perchance.org/*",
        "https://*.perchance.org/*"
      ],
      "js": [
        "content.js",
        "overlay.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_icon": "icons/icon-48.png",
    "default_title": "Toggle Image Gallery"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "options_ui": {
    "page": "options.html"
  },
  "commands": {
    "download-all": {
      "suggested_key": {
        "default": "Ctrl+Shift+D"
      },
      "description": "Download all detected images"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}

