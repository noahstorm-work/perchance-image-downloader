{
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "{e92ff565-2526-4bcc-b76c-f0994cc3cba5}"
    }
  },
  "name": "Perchance Image Downloader",
  "version": "2.4.1",
  "description": "Download generated images from Perchance AI Image Generator",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "activeTab",
    "webNavigation"
  ],
  "optional_permissions": [
    "downloads",
    "contextMenus"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "icons/svg/*", "overlay.css"],
      "matches": ["https://*.perchance.org/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://perchance.org/*",
        "https://*.perchance.org/*"
      ],
      "js": [
        "content.js",
        "overlay.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": "icons/icon-48.png",
    "default_title": "Toggle Image Gallery"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "download-all": {
      "suggested_key": {
        "default": "Ctrl+Shift+D"
      },
      "description": "Download all detected images"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
